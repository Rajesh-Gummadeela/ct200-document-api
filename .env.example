# ── Environment variables for CT-200 API ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# The application works without any values (uses defaults / fallbacks).

# SQLite database path (relative or absolute)
DATABASE_URL=sqlite:///./ct200.db

# MongoDB connection string (leave blank to use JSON file fallback)
# Example: mongodb://localhost:27017
# Example: mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URL=

# MongoDB database name
MONGO_DB_NAME=ct200

# Path for JSON file fallback store (used if MONGO_URL is empty)
JSON_STORE_PATH=./generation_store.json

# LLM provider (Groq free-tier recommended)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Groq model to use
GROQ_MODEL=llama-3.1-70b-versatile
